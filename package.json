{
  "name": "2026-workout-routine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --watch --import tsx server/index.ts",
    "build": "npm run typecheck && node --import tsx scripts/build-workout.ts",
    "build:pages": "npm run build",
    "preview:pages": "npm run build && npm start",
    "start": "node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "jsdom": "^24.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
